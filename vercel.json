{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/:lang(uk|de|es|ru)?/players/:id",
      "destination": "/app"
    },
    {
      "source": "/:lang(uk|de|es|ru)?/matches/:id",
      "destination": "/app"
    },
    {
      "source": "/:lang(uk|de|es|ru)?/me",
      "destination": "/app"
    },
    {
      "source": "/(.*)",
      "destination": "/app"
    }
  ]
}
