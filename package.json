{
  "name": "deadbuff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deadlock hero stats, win rates, builds and items — a Dotabuff-style site powered by deadlock-api.com",
  "scripts": {
    "dev": "vite",
    "dev:api": "wrangler pages dev public --port 8788 --d1 DB --binding SESSION_SECRET=local-dev-secret-not-for-production --compatibility-date 2025-09-01 --show-interactive-dev-session=false",
    "build": "tsc -b && tsc -p functions && vite build && tsx scripts/prerender.ts",
    "preview": "tsx scripts/preview.ts",
    "preview:full": "wrangler pages dev dist --port 8788 --d1 DB --binding SESSION_SECRET=local-dev-secret-not-for-production --compatibility-date 2025-09-01 --show-interactive-dev-session=false",
    "typecheck": "tsc -b --noEmit && tsc -p functions",
    "prerender": "tsx scripts/prerender.ts"
  },
  "dependencies": {
    "@floating-ui/react": "0.26.28",
    "@tanstack/react-query": "5.62.7",
    "framer-motion": "11.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261027.1",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11",
    "wrangler": "4.154.0"
  },
  "engines": {
    "node": ">=20"
  }
}
