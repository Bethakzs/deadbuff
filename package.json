{
  "name": "deadbuff",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Deadlock hero stats, win rates, builds and items — a Dotabuff-style site powered by deadlock-api.com",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && tsx scripts/prerender.ts",
