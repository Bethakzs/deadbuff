    "prerender": "tsx scripts/prerender.ts"
  },
  "dependencies": {
    "@floating-ui/react": "0.26.28",
    "@tanstack/react-query": "5.62.7",
    "framer-motion": "11.15.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0"
  },
  "devDependencies": {
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "engines": {
    "node": ">=20"
  }
}
